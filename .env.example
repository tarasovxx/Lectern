# Default: synthetic demo, no external AI requests.
PORT=8090
SESSION_SECRET=replace-with-a-long-random-string
ML_API_KEY=replace-with-a-shared-local-service-key
TRANSCRIPTION_BACKEND=demo
GENERATE_MATERIALS=false

# Local speech: accept model terms in Hugging Face before first run.
HF_TOKEN=
ASR_MODEL_NAME=large-v3-turbo
ASR_COMPUTE_TYPE=int8

# Optional local OpenAI-compatible generation server (e.g. Ollama).
LOCAL_LLM_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b

# Explicit cloud mode only; empty in demo/local.
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_GENERATION_MODELS=
